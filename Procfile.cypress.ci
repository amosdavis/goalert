@oneshot
cypress: go tool waitfor http://127.0.0.1:3042 && ./bin/tools/bun run cypress $CY_ACTION --config baseUrl=http://127.0.0.1:3040$HTTP_PREFIX

goalert: ./bin/cyserver.cover -l=127.0.0.1:3042 --stub-notifiers --log-errors-only --public-url=http://127.0.0.1:3040$HTTP_PREFIX --enable-secure-headers

proxy: go tool simpleproxy -addr=127.0.0.1:3040 http://127.0.0.1:3042
