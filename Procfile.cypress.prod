build: while true; do make -qs bin/cyserver.cover BUNDLE=1 >/dev/null || make bin/cyserver.cover BUNDLE=1 || (echo '\033[0;31mBuild Failure'; sleep 3); sleep 0.1; done

@watch-file=./bin/cyserver.cover
goalert: ./bin/cyserver.cover -l=127.0.0.1:3042 --stub-notifiers --log-errors-only --public-url=http://127.0.0.1:3040$HTTP_PREFIX --enable-secure-headers

proxy: go tool simpleproxy -addr=127.0.0.1:3040 http://127.0.0.1:3042

@oneshot
cypress: go tool waitfor http://127.0.0.1:3042 && ./bin/tools/bun run cypress $CY_ACTION --config baseUrl=http://127.0.0.1:3040$HTTP_PREFIX

@watch-file=./web/src/esbuild.config.js
ui: ./bin/tools/bun run esbuild --watch --prod

@watch-file=./web/src/esbuild.cypress.js
build-cy: ./bin/tools/bun run esbuild-cy --watch
